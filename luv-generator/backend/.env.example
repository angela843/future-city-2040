# LUV-Generator Backend - Umgebungsvariablen (TESTSYSTEM)
# Kopiere diese Datei nach ".env" und trage echte Werte ein.
# Diese Datei enthaelt KEINE echten Geheimnisse.

# Claude API Key (server-seitig, niemals im Frontend verwenden!)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude Modell fuer die Generierung
ANTHROPIC_MODEL=claude-sonnet-5

# Port des Backend-Servers
PORT=4000

# Test-/Demo-Modus: wenn true, werden Claude-Aufrufe durch einen
# deterministischen Mock ersetzt (kein API-Key noetig, fuer Tests/Demo).
LUV_TEST_MODE=false

# Erlaubte Frontend-Origin fuer CORS
FRONTEND_ORIGIN=http://localhost:5173
